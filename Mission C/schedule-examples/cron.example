# Example only. Replace absolute paths and choose either cron or systemd.
# The cron user must be allowed to write the data and log directories.
0 2 * * * "/srv/Mission C/.venv/bin/python" "/srv/Mission C/server.py" --data-root "/srv/Mission C data" scan "/srv/Mission C input" --cache-manifest "/srv/Mission C cache/manifest.json" --run >> "/srv/Mission C data/scan.jsonl" 2>> "/srv/Mission C data/scan.stderr.log"
